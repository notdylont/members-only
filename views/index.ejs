<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Club</title>
  </head>
  <body>
    <%- include('./partials/navbar.ejs') %>
    <% locals.messages.forEach((message => { %>
      <div>
        <% if(locals.user && locals.user.is_member) { %>
          <p><%= new Date(message.created_at).toLocaleString('en-CA', {  year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit'}) %></p>
          <p><%= message.username %></p>
        <% } %>
        <h4><%= message.title %></h4>
        <p><%= message.text %></p>
      </div>
    <% })) %>
  </body>
</html>
