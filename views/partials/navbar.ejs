<nav>
  <a href="/" class="nav-brand">Herbarium</a>
  <div class="nav-links">
    <% if (locals.user) { %>
      <a href="/new-msg">New post</a>
      <% if (!locals.user.is_member) { %>
        <a href="/membership">Become a member</a>
      <% } %>
      <% if (locals.user.is_member && !locals.user.is_admin) { %>
        <a href="/admin">Become an admin</a>
      <% } %>
      <button onclick="document.getElementById('logout-modal').style.display='flex'">Logout</button>
    <% } else { %>
      <a href="/login">Login</a>
      <a href="/sign-up" class="nav-primary">Sign up</a>
    <% } %>
  </div>
</nav>
<%- include('./logout-modal.ejs') %>